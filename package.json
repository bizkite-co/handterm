{
  "name": "handterm",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit",
    "build:package": "cd packages/types && npm run build",
    "build": "npm run build:package && npx vite build",
    "test:all": "npm run test:unit; npm run test:e2e",
    "test:unit": "mkdir -p vitest-output; rm -rf vitest-output/*; vitest --run",
    "test:unit-save": "mkdir -p vitest-output; rm -rf vitest-output/*; vitest --run --reporter=json --outputFile=./vitest-output/vitest.json",
    "test:save": "npm run test > temp/workig-tree-test-results.txt",
    "test:ui": "vitest --ui",
    "test:e2e": "mkdir -p test-results; PLAYWRIGHT_OUTPUT_DIR=test-results PLAYWRIGHT_REPORTERS='junit' PLAYWRIGHT_JUNIT_OUTPUT_NAME='test-results/playwright.xml' PLAYWRIGHT_TEST=1 node --loader ts-node/esm npx playwright test",
    "test:e2e-save": "echo $(date +'%Y%m%d%H%M%S') > temp/e2e_tests_workig-tree.txt && PLAYWRIGHT_TEST=1 npx playwright test >> temp/e2e_tests_workig-tree.txt",
    "test:coverage": "vitest run --coverage"
  },
  "config": {
    "checklist_path": "docs/worklog/reconcile-mock-types-with-prod/migrate-from-monaco-editor-react/full-rewrite-checklist.md"
  },
